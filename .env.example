# Database
POSTGRES_USER=reserve
POSTGRES_PASSWORD=CHANGE_ME_to_a_secure_password
POSTGRES_DB=mobile_reserve

# Security
JWT_SECRET=CHANGE_ME_to_a_random_string_min_32_chars

# Seed Data (only needed for initial setup)
ADMIN_PASSWORD=CHANGE_ME_admin_password
DEFAULT_PASSWORD=CHANGE_ME_default_password

# Push Notifications (Optional, but recommended)
# VAPID_PRIVATE_KEY=
# VAPID_PUBLIC_KEY=
# VAPID_SUBJECT=mailto:admin@example.com

# SMTP (optional, configure in app settings)
# SMTP_HOST=smtp.example.com
# SMTP_USER=user@example.com
# SMTP_PASS=smtp_password

# Cronjob (for nightly GDPR cleanup, see DEPLOYMENT.md)
# WICHTIG: Ohne diesen Wert läuft die nächtliche DSGVO-Bereinigung NICHT
# (der Endpunkt antwortet dann bewusst mit HTTP 500 statt unsicher zu authentifizieren).
CRON_SECRET=CHANGE_ME_to_a_random_string

# App URL – PFLICHT in Produktion.
# Wird für die Links in Passwort-Reset-E-Mails gebraucht (und als Identitaet fuer
# Push-Benachrichtigungen). Ohne diesen Wert versendet die App bewusst KEINE
# Reset-Links, weil ein aus Request-Headern gebauter Link faelschbar waere.
NEXT_PUBLIC_APP_URL=https://app.schulamt-musterstadt.de
