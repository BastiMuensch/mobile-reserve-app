# Database
POSTGRES_USER=reserve
POSTGRES_PASSWORD=CHANGE_ME_to_a_secure_password
POSTGRES_DB=mobile_reserve

# Security
JWT_SECRET=CHANGE_ME_to_a_random_string_min_32_chars
# Einmaliger Zugriffsschutz für die Ersteinrichtungsmaske. Auch nach Abschluss gesetzt lassen.
SETUP_TOKEN=CHANGE_ME_to_a_random_setup_token_min_32_chars
# 32 zufällige Bytes, Base64-kodiert: `openssl rand -base64 32`
SMTP_ENCRYPTION_KEY=CHANGE_ME_to_a_base64_encoded_32_byte_key
# Separater HMAC-Schlüssel für Einladungslinks: `openssl rand -hex 32`
INVITATION_TOKEN_PEPPER=CHANGE_ME_to_a_random_invitation_pepper
# Nur während einer geplanten Rotation setzen. Nach erfolgreichem SMTP-Test wieder entfernen.
# SMTP_ENCRYPTION_KEY_PREVIOUS=

# Update-Hinweise (optional)
# Fragt GitHub serverseitig höchstens einmal täglich ab; nach einem App-Neustart beim nächsten Dashboard-Aufruf erneut.
# Es werden keine Schulamtsdaten übertragen und die App installiert niemals selbst Updates.
UPDATE_CHECK_ENABLED=true

# Geocoding (optional; Standard ist der öffentliche OpenStreetMap-Nominatim-Dienst)
# Für Lehrkräfte wird ausschließlich die fünfstellige PLZ übertragen. Die vollständige
# Privatanschrift bleibt in dieser Installation. Schul- und Behördenadressen dürfen als
# vollständige Anschrift geocodiert werden.
GEOCODING_BASE_URL=https://nominatim.openstreetmap.org
# Für produktive Installationen möglichst eine erreichbare Kontaktadresse angeben.
GEOCODING_USER_AGENT=MobileReserve.digital/1.0 (kontakt@ihre-domain.de)

# Push Notifications (Optional, but recommended for production)
# WICHTIG: Wenn hier KEIN Schlüsselpaar gesetzt wird, erzeugt die App beim ersten Gebrauch
# selbst eines und legt es in der Datenbank ab (SystemSetting). Geht diese Datenbank verloren
# oder wird sie zurückgesetzt, wird beim nächsten Start ein NEUES Paar erzeugt - und ALLE
# bisherigen Push-Abos der Lehrkräfte werden dadurch dauerhaft ungültig (die Nutzer müssten
# Push erneut aktivieren). Für den Produktivbetrieb daher unbedingt ein festes Paar setzen.
#
# Paar erzeugen (einmalig, z.B. lokal mit dem im Projekt vorhandenen Paket):
#   npx web-push generate-vapid-keys
# Die Ausgabe liefert Public und Private Key - beide unten eintragen (immer BEIDE zusammen,
# ein einzeln gesetzter Wert wird von der App als Konfigurationsfehler abgelehnt).
# VAPID_PRIVATE_KEY=
# VAPID_PUBLIC_KEY=
#
# Kontaktadresse, die Push-Diensten (z.B. bei Zustellproblemen) mitgeteilt wird. Muss eine
# echte, erreichbare Adresse sein (mailto: oder https://) - manche Push-Dienste lehnen
# Platzhalter wie "admin@example.com" ab. Ohne diesen Wert verwendet die App automatisch
# NEXT_PUBLIC_APP_URL (siehe unten) als Subject, was für Produktivbetrieb ausreicht.
# VAPID_SUBJECT=mailto:ihre-echte-adresse@ihre-domain.de

# SMTP (optional, configure in app settings)
# SMTP_HOST=smtp.example.com
# SMTP_USER=user@example.com
# SMTP_PASS=smtp_password

# DSGVO-Bereinigung
# Die App bringt ihren eigenen Zeitplan mit und bereinigt einmal taeglich automatisch
# (bevorzugt nachts). Ein Linux-Cronjob ist dafuer NICHT noetig - siehe DEPLOYMENT.md, Teil 3.
# Auf "off" setzen, wenn stattdessen ausschliesslich extern per Cron ausgeloest werden soll.
# Der E-Mail-Outbox-Takt bleibt davon unabhängig aktiv.
# GDPR_CLEANUP_SCHEDULER=off
# Nur für Tests oder einen bewusst extern betriebenen Mail-Worker deaktivieren.
# OUTBOX_SCHEDULER=off
#
# CRON_SECRET wird NUR fuer den optionalen externen Aufruf von /api/cron/cleanup gebraucht.
# Ohne diesen Wert antwortet der Endpunkt bewusst mit HTTP 500, statt unsicher zu
# authentifizieren. Der eingebaute Zeitplan laeuft davon unabhaengig.
# CRON_SECRET=CHANGE_ME_to_a_random_string

# App URL – PFLICHT in Produktion.
# Wird für die Links in Passwort-Reset-E-Mails gebraucht (und als Identitaet fuer
# Push-Benachrichtigungen). Ohne diesen Wert versendet die App bewusst KEINE
# Reset-Links, weil ein aus Request-Headern gebauter Link faelschbar waere.
NEXT_PUBLIC_APP_URL=https://app.ihre-domain.de
