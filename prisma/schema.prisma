generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String?
  role      String   // "ADMIN", "SCHULAMT", "SCHOOL", "TEACHER"
  createdAt DateTime @default(now())
  schoolId  String?  @unique
  school    School?  @relation(fields: [schoolId], references: [id])
  schoolsManaged School[] @relation("SchulamtSchools")
  teachers  Teacher[]
  schulamtProfile SchulamtProfile?
}

model School {
  id          String   @id @default(uuid())
  name        String
  address     String
  latitude    Float
  longitude   Float
  type        String   // "GRUNDSCHULE", "MITTELSCHULE"
  generalInfo String?  // Optional info text
  imageUrl    String?  // Optional uploaded image URL
  pinLat      Float?   // Optional map pin for entrance
  pinLng      Float?   // Optional map pin for entrance
  
  user        User?
  schulamtId  String?
  schulamt    User?    @relation("SchulamtSchools", fields: [schulamtId], references: [id])
  teachers    Teacher[] // Stammschule relationship
  requests    Request[]

  @@index([schulamtId])
}

model Teacher {
  id                String  @id @default(uuid())
  name              String
  email             String? // For notifications
  phone             String? // Contact phone number
  stammschuleId     String
  stammschule       School  @relation(fields: [stammschuleId], references: [id])
  maxWeeklyHours    Int
  isPartTime        Boolean @default(false)
  schedule          String? // JSON string: {"1":[1,2],"2":[1,2]...} where 1=Mon, 2=Tue, array=hours
  qualifications    String  // comma separated, e.g. "Sport,Technik"
  status            String  // "ACTIVE", "SICK", "LEAVE"
  address           String  @default("") // Teacher's home address
  gender            String? // "FEMALE", "MALE", "DIVERSE" – used for PDF salutation
  homeLat           Float
  homeLng           Float
  preferredType     String  // "GRUNDSCHULE", "MITTELSCHULE", "BOTH"
  schoolYear        String  @default("2025/2026")
  
  userId            String?
  user              User?   @relation(fields: [userId], references: [id])
  
  assignments       Assignment[]
  absences          Absence[]

  @@index([stammschuleId])
  @@index([userId])
  @@index([schoolYear])
}

model Request {
  id             String  @id @default(uuid())
  schoolId       String
  school         School  @relation(fields: [schoolId], references: [id])
  date           DateTime
  endDate        DateTime? // Optional end date for a period
  priority       String  @default("ERKRANKUNG") // "ERKRANKUNG", "FORTBILDUNG", "SCHULINTERN"
  startHour      Int     @default(1)
  hours          Int     // Number of hours needed per day
  weeklyHours    Int     @default(0) // Total hours needed for the entire period
  schoolType     String  @default("GRUNDSCHULE") // "GRUNDSCHULE", "MITTELSCHULE", "GS_MS"
  substitutedTeacher String  // Name of the teacher to be substituted
  schedule       String? // JSON string for long-term request schedules
  qualifications String  // Required qualifications, comma separated
  comments       String? // Optional comments like start time, parking info
  status         String  // "PENDING", "FILLED", "CANCELLED", "PARTIALLY_FILLED"
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  
  assignments    Assignment[]

  @@index([schoolId])
}

model Assignment {
  id         String  @id @default(uuid())
  requestId  String  
  request    Request @relation(fields: [requestId], references: [id])
  teacherId  String
  teacher    Teacher @relation(fields: [teacherId], references: [id])
  date       DateTime
  hours      Int     // Hours actually assigned
  status     String  @default("PENDING") // "PENDING", "ACCEPTED", "REJECTED"

  @@index([requestId])
  @@index([teacherId])
  @@index([date])
}

model Absence {
  id        String   @id @default(uuid())
  teacherId String
  teacher   Teacher  @relation(fields: [teacherId], references: [id])
  date      DateTime
  type      String   // "SICK", "LEAVE"

  @@index([teacherId])
}

model SystemSetting {
  id    String @id
  value String
}

model SchulamtProfile {
  id               String   @id @default(uuid())
  userId           String   @unique
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  headerText       String   @default("Staatliche Schulämter im Landkreis Unterallgäu und in der Stadt Memmingen")
  returnAddress    String   @default("Staatliches Schulamt Unterallgäu - Memminger Str. 18 - 87719 Mindelheim")
  logoUrl          String?
  contactAddress   String   @default("Memminger Str. 18\n87719 Mindelheim\nTelefon 08261 995 341\nTelefax 08261 995 383")
  contactPerson    String   @default("Tamara Schmidt\nDurchwahl: 08261 995 441\nSchA\nschulamts@lra.unterallgaeu.de\nwww.schulamt.mm.unterallgaeu.de")
  city             String   @default("Mindelheim")
  amtsleitungName  String   @default("Ursula Abt")
  amtsleitungTitle String   @default("Schulamtsdirektorin")
  signatureUrl     String?
  smtpHost         String?
  smtpUser         String?
  smtpPass         String?
}

