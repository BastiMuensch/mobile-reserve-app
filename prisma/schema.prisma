generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String               @id @default(uuid())
  email               String               @unique
  password            String
  name                String?
  role                String // legacy "ADMIN" (no web access), active: "SCHULAMT", "SCHOOL", "TEACHER"
  isActive            Boolean              @default(true)
  sessionVersion      Int                  @default(0)
  createdAt           DateTime             @default(now())
  schoolId            String?              @unique
  school              School?              @relation(fields: [schoolId], references: [id])
  schoolsManaged      School[]             @relation("SchulamtSchools")
  teachers            Teacher[]
  schulamtProfile     SchulamtProfile?
  pushSubscriptions   PushSubscription[]
  uploadedAssets      UploadedAsset[]
  passwordResetTokens PasswordResetToken[]
  teacherInvitations  TeacherInvitation[]  @relation("SchulamtTeacherInvitations")
}

model TeacherInvitation {
  id             String    @id @default(uuid())
  schulamtId     String
  schulamt       User      @relation("SchulamtTeacherInvitations", fields: [schulamtId], references: [id], onDelete: Cascade)
  recipientEmail String
  activeKey      String?   @unique
  tokenHash      String    @unique
  expiresAt      DateTime
  createdAt      DateTime  @default(now())
  revokedAt      DateTime?
  completedAt    DateTime?

  @@index([schulamtId, recipientEmail])
  @@index([expiresAt])
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model PushSubscription {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  @@index([userId])
}

// Records the owner and intended use of an uploaded file before a profile may
// reference it. Filesystem paths alone cannot establish ownership safely.
model UploadedAsset {
  id            String   @id @default(uuid())
  ownerUserId   String
  owner         User     @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  url           String   @unique
  purpose       String
  createdAt     DateTime @default(now())

  @@index([ownerUserId, purpose])
}

model School {
  id                     String    @id @default(uuid())
  name                   String
  address                String
  latitude               Float?
  longitude              Float?
  geocodingStatus        String    @default("PENDING") // "PENDING", "RESOLVED", "NOT_FOUND", "UNAVAILABLE", "MANUAL"
  geocodingLastAttemptAt DateTime?
  geocodingError         String?
  type                   String // "GRUNDSCHULE", "MITTELSCHULE"
  generalInfo            String? // Optional info text
  imageUrl               String? // Optional uploaded image URL
  // Legacy, unclassified pin. It is deliberately retained for backwards
  // compatibility and must never be inferred to mean entrance or parking.
  pinLat                 Float?
  pinLng                 Float?
  // Navigation points maintained explicitly by the school profile.
  entranceLat            Float?
  entranceLng            Float?
  parkingLat             Float?
  parkingLng             Float?

  // Kleine Schulen haben kaum eigenes Kollegium, das einen Ausfall auffangen kann.
  // Ihre Bedarfe werden deshalb dringlicher eingestuft (siehe src/lib/urgency.ts).
  // Bewusst ein Häkchen des Schulamts statt einer Automatik über die Kollegiumsgröße:
  // Das Schulamt kennt seine Schulen, eine gepflegte Zahl würde veralten.
  isSmall                Boolean   @default(false)
  // Manuelle Übersteuerung der automatischen Häufungs-Erkennung, beide Richtungen und
  // beide BEFRISTET: Ein Schalter ohne Ablaufdatum würde die Automatik dauerhaft
  // verfälschen - eine einmal abgewählte Schule wäre bei der nächsten echten Welle
  // Monate später immer noch stumm geschaltet.
  outbreakUntil          DateTime? // bis dahin gilt die Schule als Häufung, auch ohne Erkennung
  outbreakDismissedUntil DateTime? // bis dahin wird eine erkannte Häufung unterdrückt

  user       User?
  schulamtId String?
  schulamt   User?     @relation("SchulamtSchools", fields: [schulamtId], references: [id])
  teachers   Teacher[] // Stammschule relationship
  requests   Request[]

  @@index([schulamtId])
}

model Teacher {
  id             String  @id @default(uuid())
  name           String
  email          String? // For notifications
  phone          String? // Contact phone number
  stammschuleId  String
  stammschule    School  @relation(fields: [stammschuleId], references: [id])
  maxWeeklyHours Int
  isPartTime     Boolean @default(false)
  schedule       String? // JSON string: {"1":[1,2],"2":[1,2]...} where 1=Mon, 2=Tue, array=hours
  qualifications String // comma separated, e.g. "Sport,Technik"
  status         String // "ACTIVE", "UNAVAILABLE", "LEAVE"
  address        String  @default("") // Teacher's home address
  postalCode     String  @default("") // Only this value may be sent to the public geocoder
  gender         String? // "FEMALE", "MALE", "DIVERSE" – used for PDF salutation
  homeLat        Float
  homeLng        Float
  preferredType  String // "GRUNDSCHULE", "MITTELSCHULE", "BOTH"
  schoolYear     String  @default("2025/2026")

  userId String?
  user   User?   @relation(fields: [userId], references: [id])

  assignments  Assignment[]
  absences     Absence[]
  leavePeriods LeavePeriod[]

  @@index([stammschuleId])
  @@index([userId])
  @@index([schoolYear])
}

model PostalCodeGeocode {
  postalCode String   @id
  latitude   Float
  longitude  Float
  source     String   @default("NOMINATIM")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Request {
  id                 String    @id @default(uuid())
  schoolId           String
  school             School    @relation(fields: [schoolId], references: [id])
  // A client-generated key identifies one submit attempt. It is optional only
  // for pre-idempotency rows and imports; new API writes always provide it.
  idempotencyKey     String?
  // SHA-256 of the normalized, effective submit payload. It lets retries prove
  // they are replaying the same attempt without storing the request body twice.
  idempotencyFingerprint String?
  date               DateTime
  endDate            DateTime? // Optional end date for a period
  // "Bis auf Weiteres": Bei einer Erkrankung kennt die Schule das Ende nicht. Der Bedarf
  // läuft dann weiter und wird über einen rollierenden Horizont besetzt (siehe
  // OPEN_ENDED_HORIZON_DAYS in src/lib/requestDays.ts), bis die Schule die Rückkehr
  // meldet.
  //
  // ACHTUNG, gegenläufige Konvention: Ein leeres endDate bedeutet bei Request "genau ein
  // Tag" – anders als beim LeavePeriod, wo null "offen" heißt. Deshalb dieses eigene
  // Kennzeichen statt einer Umdeutung von null.
  isOpenEnded        Boolean   @default(false)
  endedAt            DateTime? // wann die Schule die Rückkehr gemeldet hat
  priority           String    @default("UNPLANNED_ABSENCE") // "UNPLANNED_ABSENCE", "FORTBILDUNG", "SCHULINTERN"
  startHour          Int       @default(1)
  hours              Int // Number of hours needed per day
  weeklyHours        Int       @default(0) // Total hours needed for the entire period
  schoolType         String    @default("GRUNDSCHULE") // "GRUNDSCHULE", "MITTELSCHULE", "GS_MS"
  substitutedTeacher String // Name of the teacher to be substituted
  schedule           String? // JSON string for long-term request schedules
  qualifications     String // Required qualifications, comma separated
  comments           String? // Optional comments like start time, parking info
  status             String // "PENDING", "FILLED", "CANCELLED", "PARTIALLY_FILLED", "UNFILLED"
  // UNFILLED = das Schulamt konnte keine Mobile Reserve stellen und hat das der Schule
  // ausdrücklich mitgeteilt. Rücknehmbar: beim Zurückholen werden beide Felder geleert
  // und der Status aus den vorhandenen Zuweisungen neu berechnet.
  unfilledReason     String?
  unfilledAt         DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  assignments Assignment[]

  @@index([schoolId])
  @@unique([schoolId, idempotencyKey])
}

model Assignment {
  id        String   @id @default(uuid())
  requestId String
  request   Request  @relation(fields: [requestId], references: [id])
  teacherId String
  teacher   Teacher  @relation(fields: [teacherId], references: [id])
  date      DateTime
  hours     Int // Hours actually assigned
  status    String   @default("PENDING") // "PENDING", "ACCEPTED", "REJECTED"

  @@index([requestId])
  @@index([teacherId])
  @@index([date])
}

model Absence {
  id        String   @id @default(uuid())
  teacherId String
  teacher   Teacher  @relation(fields: [teacherId], references: [id])
  date      DateTime
  type      String // "UNAVAILABLE", "LEAVE"
  reason    String? // Begründung der Lehrkraft bei ungeplantem Ausfall
  createdAt DateTime @default(now())

  @@index([teacherId])
  @@index([date])
}

// Längere Abwesenheit über einen Zeitraum (z.B. Mutterschutz, Elternzeit, längere
// Erkrankung). Bewusst getrennt von Absence: Absence ist die tagesgenaue Selbstmeldung
// eines ungeplanten Ausfalls, hier geht es um einen im Voraus bekannten Zeitraum, den
// auch das Schulamt eintragen darf. Die Lehrkraft bleibt samt Einsatzhistorie erhalten
// und fällt nur für diesen Zeitraum aus dem Matching (siehe rankCandidates in
// src/lib/matching.ts).
//
// DATENSPARSAMKEIT (Art. 5 Abs. 1 lit. c DSGVO): Der GRUND wird bewusst NICHT erfasst.
// Mutterschutz, Schwangerschaft oder eine Erkrankung sind Gesundheitsdaten nach Art. 9
// DSGVO; für die Einsatzplanung genügt der Zeitraum. Der Grund wird wie bisher per
// Dienst-E-Mail oder telefonisch gemeldet und gehört nicht in diese Anwendung.
model LeavePeriod {
  id         String    @id @default(uuid())
  teacherId  String
  teacher    Teacher   @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  startDate  DateTime
  endDate    DateTime? // null = bis auf Weiteres
  reportedBy String // "TEACHER" oder "SCHULAMT" – wer den Zeitraum eingetragen hat
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([teacherId])
  @@index([startDate])
  @@index([endDate])
}

model SystemSetting {
  id    String @id
  value String
}

model SchulamtProfile {
  id                        String    @id @default(uuid())
  userId                    String    @unique
  user                      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  headerText                String    @default("")
  returnAddress             String    @default("")
  logoUrl                   String?
  latitude                  Float?
  longitude                 Float?
  contactAddress            String    @default("")
  contactPerson             String    @default("")
  city                      String    @default("")
  amtsleitungName           String    @default("")
  amtsleitungTitle          String    @default("")
  signatureUrl              String?
  documentSubject           String    @default("Verwendung als mobile Reserve innerhalb des Schulamtsbereiches")
  documentIntro             String    @default("Zur Verwendung als mobile Reserve werden Sie wie folgt eingesetzt:")
  documentLegalText         String    @default("Umzugskostenvergütung wird nicht zugesagt.\n\nBei einer Abordnung an einen Ort außerhalb des Dienst- oder Wohnortes ohne Zusage der Umzugskostenvergütung erhalten Sie auf Antrag Trennungsgeld (Entschädigung bei täglicher Rückkehr zum Wohnort) nach der BayTGV (Art. 22 Abs. 1 BayRKG i. V. m. § 1 Abs. 1 Nr. 3 BayTGV).\n\nEinem etwaigen Antrag auf Trennungsgeld ist dieses Abordnungsschreiben (ggf. Ablichtung) beizufügen.")
  documentClosing           String    @default("Mit freundlichen Grüßen")
  mailProvider              String    @default("NONE") // "NONE", "SMTP"; weitere Provider können ergänzt werden
  smtpHost                  String?
  smtpPort                  Int?
  smtpSecure                Boolean   @default(false)
  smtpUser                  String?
  smtpPass                  String?
  smtpFromName              String?
  smtpFromAddress           String?
  teacherInviteValidityDays Int       @default(14)
  lastBackupDate            DateTime?
}

model EmailOutbox {
  id               String    @id @default(uuid())
  schulamtId       String?
  // Contains recipient, subject, body and attachments together. Keeping all
  // personally identifiable mail data in one authenticated encrypted payload
  // prevents accidental plaintext columns or partial encryption.
  payloadEncrypted String?
  status           String    @default("PENDING") // "PENDING", "SENDING", "SENT", "FAILED"
  attempts         Int       @default(0)
  maxAttempts      Int       @default(5)
  // A deliberately generic, capped operational error. Never store SMTP
  // responses because they can contain recipient addresses or message text.
  lastError        String?
  nextAttemptAt    DateTime  @default(now())
  leaseToken       String?
  leaseExpiresAt   DateTime?
  sentAt           DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([status, nextAttemptAt])
  @@index([status, leaseExpiresAt])
  @@index([schulamtId])
  @@index([createdAt])
}
