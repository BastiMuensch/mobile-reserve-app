# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma
prisma/data
*.db
*.db-journal

# sensitive / utility files
cookies.txt
trim.py
venv/

# generated reports / local db artifacts that should not be versioned
eslint_report.json
eslint_report.txt
new_migration.sql
latest.sql

# Landing-Werkzeuge (Playwright), nicht Teil des Deployments
landing/node_modules
